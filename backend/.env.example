PORT=3000
# En Railway usa DATABASE_URL. En local puedes usar las variables DB_* de abajo.
DATABASE_URL=
DB_SSL=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tienda_victor
DB_USER=postgres
DB_PASSWORD=pon_aqui_tu_contrasena
AUTH_SECRET=cambia_por_una_clave_larga_y_unica
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_la_contrasena_del_administrador
# Dominio público del frontend; varios dominios se separan con coma.
CORS_ORIGIN=http://localhost:5173
# En Railway con Volume: /data/uploads
UPLOADS_DIR=
